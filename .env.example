# Optional: copy to .env beside Syspect.exe. No secrets are required.
# Defaults keep user data outside the installation, surviving updates/uninstall.
SYSPECT_PORT=37841
# SYSPECT_DATA_DIR=C:\Users\YourName\AppData\Local\Syspect\data
SYSPECT_SCAN_TIMEOUT_SECONDS=300
SYSPECT_SESSION_HOURS=168
# Optional exact HTTPS test origin. Empty keeps localhost-only access.
# SYSPECT_PUBLIC_ORIGIN=https://your-domain.ngrok-free.dev
